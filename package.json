{
  "name": "argsclopts",
  "description": "cliclopts but for Node.js parseArgs",
  "version": "1.0.5",
  "author": "Bret Comnes <bcomnes@gmail.com> (https://bret.io)",
  "bugs": {
    "url": "https://github.com/bcomnes/argsclopts/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@voxpelli/tsconfig": "^17.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.13.0",
    "neostandard": "^0.14.1",
    "npm-run-all2": "^9.0.0",
    "releasearoni": "^0.2.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10"
  },
  "homepage": "https://github.com/bcomnes/argsclopts",
  "keywords": [],
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "type": "module",
  "module": "index.js",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcomnes/argsclopts.git"
  },
  "scripts": {
    "prepublishOnly": "releasearoni",
    "postpublish": "npm run clean",
    "test": "run-s test:*",
    "test:lint": "eslint",
    "test:node-test": "node --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info --test",
    "test:tsc": "tsc",
    "version": "releasearoni version",
    "clean": "run-p clean:*",
    "clean:declarations-top": "rm -rf $(find . -maxdepth 1 -type f -name '*.d.ts*')",

    "build": "npm run clean && run-p build:*",
    "build:declaration": "tsc -p declaration.tsconfig.json"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bcomnes"
  }
}
